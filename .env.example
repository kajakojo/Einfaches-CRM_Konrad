# =================================================================
# DATENBANK-KONFIGURATION (vom Benutzer anpassbar)
# =================================================================
# Hinweis: Diese Datei dient als Vorlage. Kopieren Sie sie zu '.env'
# und tragen Sie Ihre eigenen Werte ein.
#
# Diese Datei wird von der Software automatisch eingelesen.
# =================================================================

# Flask-Konfiguration
SECRET_KEY=your-secret-key-here-change-this-in-production
FLASK_APP=manage.py
FLASK_ENV=development
DEBUG=True

# =================================================================
# DATENBANK-OPTIONEN
# =================================================================
# Wählen Sie EINE der folgenden Optionen:

# -------------------------------------------
# Option 1: SQLite (Standard - keine Installation nötig)
# -------------------------------------------
DATABASE_URL=sqlite:///app.db

# -------------------------------------------
# Option 2: MySQL/MariaDB
# -------------------------------------------
# Entfernen Sie das '#' und passen Sie die Werte an:
# DB_TYPE=mysql
# DB_USER=ihr_mysql_benutzer
# DB_PASSWORD=ihr_mysql_passwort
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=crm_database

# -------------------------------------------
# Option 3: PostgreSQL
# -------------------------------------------
# Entfernen Sie das '#' und passen Sie die Werte an:
# DB_TYPE=postgresql
# DB_USER=ihr_postgres_benutzer
# DB_PASSWORD=ihr_postgres_passwort
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=crm_database

# =================================================================
# BEISPIEL-WERTE (für Entwicklung/Test)
# =================================================================
# DB_TYPE=mysql
# DB_USER=crm_user
# DB_PASSWORD=sicheres_passwort_123
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=einfaches_crm_db
# =================================================================